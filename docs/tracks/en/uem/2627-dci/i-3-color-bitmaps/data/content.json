    {
      "slide_role": "masterclass",
      "background_kind": "profield",
      "heading": "2 · A bitmap has limits",
      "sentence": "A bitmap is a fixed grid of colour values — mode, depth, and gamut close later options.",
      "quote": "Every bit you spend on colour is a door you may not reopen later.",
      "quote_origin": "tao_invented",
      "semantic_tags": {
