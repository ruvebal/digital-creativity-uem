  "slides": [
    {
      "heading": "Digital images",
      "sentence": "Produce a small labelled set of digital fashion images, annotated by practice and boundary, as this course’s first studio artefact.",
      "prompt": "I.1 · Introduction to Digital Images",
      "media_slot_id": "I.1.still.profield-1",
      "background_kind": "profield"
    },
    {
      "heading": "1 · Field of practices",
      "sentence": "A digital fashion image is defined by who made it, for what venue, and under which shared goals.",
      "media_slot_id": "I.1.still.profield-2",
      "background_kind": "profield"
    },
    {
      "heading": "2 · Not a file format",
      "sentence": "JPEG, PNG, GIF, and RAW describe technical containers; they do not tell us what a fashion image does.",
      "media_slot_id": "I.1.still.profield-3",
      "background_kind": "profield"
    },
    {
      "heading": "3 · Many collaborators",
      "sentence": "Fashion images gather photographers, stylists, models, designers, editors, producers, and audiences around a shared situation.",
      "media_slot_id": "I.1.still.profield-4",
      "background_kind": "profield"
    },
    {
      "heading": "4 · More than one genre",
      "sentence": "Editorial, advertising, beauty, portraiture, and documentary practices can all belong to fashion-image culture.",
      "media_slot_id": "I.1.still.profield-5",
      "background_kind": "profield"
    },
    {
      "heading": "5 · Art and commerce",
      "sentence": "Fashion images can occupy artistic and commercial realms at the same time.",
      "media_slot_id": "I.1.still.profield-6",
      "background_kind": "profield"
    },
    {
      "heading": "6 · A permeable boundary",
      "sentence": "The boundary between art and commerce shifts with caption, venue, commission, audience, and circulation.",
      "media_slot_id": "I.1.still.profield-7",
      "background_kind": "profield"
    },
    {
      "heading": "7 · Read the circulation",
      "sentence": "Meaning changes when the same image moves between runway, retail, editorial, social media, and exhibition contexts.",
      "media_slot_id": "I.1.still.profield-8",
      "background_kind": "profield"
    },
    {
      "heading": "8 · Make the process visible",
      "sentence": "An image analysis should retain its source, audience, purpose, observations, and classification decision.",
      "prompt": "Save the analysis as the first portfolio trace.",
      "media_slot_id": "I.1.still.profield-9",
      "background_kind": "profield"
    },
    {
      "heading": "II · Debate 1",
      "sentence": "If the same image reads as art in a gallery caption and commerce in an advertisement, whose intent decides what it is?",
      "prompt": "Maker, venue, or viewer? Defend one position.",
      "media_slot_id": "I.1.still.profield-10",
      "background_kind": "profield"
    },
    {
      "heading": "II · Debate 2",
      "sentence": "Does a changing caption change the image, or does it reveal a meaning that was already there?",
      "prompt": "Use one visible detail and one circulation clue.",
      "media_slot_id": "I.1.still.profield-11",
      "background_kind": "profield"
    },
    {
      "heading": "II · Debate 3",
      "sentence": "Can an image be both commercially useful and artistically serious without resolving the tension?",
      "prompt": "Listen for the boundary each speaker assumes.",
      "media_slot_id": "I.1.still.profield-12",
      "background_kind": "profield"
    },
    {
      "heading": "III · Critical 1",
      "sentence": "Digital mediatization reaches how fashion is communicated, how runway design and retail are organised, and how visible self-fashioning becomes everyday practice.",
      "citation": {
        "label": "(Rocamora 2017)",
        "href": "/digital-creativity-uem/lessons/en/digital-creativity-i/i-1-digital-images/#ref-rocamora-2017"
      },
      "prompt": "Read circulation and venue, not only file format.",
      "media_slot_id": "I.1.still.profield-13",
      "background_kind": "profield"
    },
    {
      "heading": "III · Critical 2",
      "sentence": "Before collecting references, audit who appears as the normal body, legitimate designer, and fashion subject in supposedly neutral studio materials.",
      "citation": {
        "label": "(Reddy-Best et al. 2018)",
        "href": "/digital-creativity-uem/lessons/en/digital-creativity-i/i-1-digital-images/#ref-reddy-best-2018"
      },
      "prompt": "Who is missing from the frame and from the archive?",
      "media_slot_id": "I.1.cover.ladies",
      "background_kind": "profield"
    },
    {
      "heading": "III · Critical 3",
      "sentence": "Every visual reference carries an audience, a power relation, and an omission that can be made discussable.",
      "prompt": "Name the relation your chosen image makes visible.",
      "media_slot_id": "I.1.still.profield-1",
      "background_kind": "profield"
    },
    {
      "heading": "IV · Diagnostic",
      "sentence": "Given an unlabelled fashion-image description, assign the most defensible field-of-practice label and justify it in two sentences.",
      "prompt": "Work alone; no tool or AI needed.",
      "media_slot_id": "I.1.still.profield-2",
      "background_kind": "profield"
    },
    {
      "heading": "IV · Boundary judgement",
      "sentence": "Given an ambiguous artistic or commercial placement, write a one-sentence boundary judgement by hand.",
      "prompt": "Declare the evidence you used.",
      "media_slot_id": "I.1.still.profield-3",
      "background_kind": "profield"
    },
    {
      "heading": "IV · The JPEG problem",
      "sentence": "Explain why “it’s a JPEG” is not an answer to “what kind of fashion image is this?”",
      "prompt": "Use the distinction between file format and field of practice.",
      "media_slot_id": "I.1.still.profield-4",
      "background_kind": "profield"
    },
    {
      "heading": "IV · Portfolio trace",
      "sentence": "Collect the analysis, debate position, critical audit, and problem response as the first material of the public portfolio defence.",
      "prompt": "Save source, version, and one changed judgement.",
      "media_slot_id": "I.1.still.profield-5",
      "background_kind": "profield"
    }
  ]
}
