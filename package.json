{
	"name": "digital-creativity-uem",
	"version": "0.1.0",
	"description": "Digital Creativity / Creación Digital — fashion avatars, web portfolio, AR — Universidad Europea teaching site",
	"private": true,
	"scripts": {
		"postcss:build": "postcss docs/assets/css/tailwind.css -o docs/assets/css/tailwind-processed.css",
		"postcss:watch": "postcss docs/assets/css/tailwind.css -o docs/assets/css/tailwind-processed.css --watch",
		"normalize:ids": "node scripts/normalize-ids.mjs",
		"mark-broken-links": "node scripts/mark-broken-links.mjs",
		"link:external-refs": "node scripts/link-external-reference-urls.mjs",
		"link:citations": "node scripts/link-lesson-citations.mjs",
		"generate:lesson-covers": "node scripts/lesson-covers/generate-lesson-covers.mjs",
		"generate:archive-covers": "node scripts/archive-covers/generate-archive-covers.mjs . uem",
		"generate:page-art": "node scripts/generate-page-art.mjs",
		"generate:pass-track-art": "bash scripts/fractal-architecture/generate-pass-track-backgrounds.sh",
		"verify:publication": "node scripts/verify-publication-safety.mjs",
		"verify:citations": "node scripts/verify-publication-safety.mjs --citations",
		"media:refresh": "bash scripts/media-refresh.sh",
		"media:refresh:i1": "bash scripts/media-refresh.sh",
		"hydrate": "node scripts/hydrate-directory.mjs",
		"media:rehydrate": "node scripts/rehydrate-student-media.mjs",
		"predevelop": "bash scripts/kill-dev-ports.sh && npm run hydrate && npm run media:refresh && npm run media:rehydrate",
		"develop": "npm run postcss:build && bundle exec jekyll serve --source docs --livereload --livereload-port ${LIVERELOAD_PORT:-35730} --config _config.yml --port ${PORT:-4002}",
		"prebuild": "npm run hydrate && npm run media:rehydrate",
		"build": "npm run postcss:build && bundle exec jekyll build --source docs --destination _site --config _config.yml && npm run verify:publication && npm run verify:citations",
		"validate:yaml": "find docs/_data -name '*.yml' -exec yamllint {} \\;"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"autoprefixer": "^10.4.21",
		"cheerio": "^1.1.2",
		"cssnano": "^7.1.2",
		"fs-extra": "^11.2.0",
		"glob": "^10.3.10",
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.1.0",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"slugify": "^1.6.6",
		"tailwindcss": "^3.4.18",
		"yaml-lint": "^1.7.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ruvebal/digital-creativity-uem.git"
	},
	"author": "Rubén Vega Balbás, PhD — Creative Technologist & Developer",
	"license": "MIT"
}
