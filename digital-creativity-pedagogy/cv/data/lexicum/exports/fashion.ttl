fashion:Field a skos:Collection ;
    dct:title "Fashion"@en ;
    dct:description "A controlled vocabulary for the fashion domain — design, business, and communication — modelled as SKOS concept schemes with an optional CIDOC-CRM mapping layer."@en .

fashion:fashion_business a skos:ConceptScheme ;
    dct:title "Fashion Business"@en ;
    dct:description "Sourcing, production economics, retail operations, distribution models, and sustainability governance."@en ;
    dct:isPartOf fashion:Field .

fashion:fashion_communication a skos:ConceptScheme ;
    dct:title "Fashion Communication"@en ;
    dct:description "Brand identity, editorial and press practice, styling, events, and digital/social communication."@en ;
    dct:isPartOf fashion:Field .

fashion:fashion_design a skos:ConceptScheme ;
    dct:title "Fashion Design"@en ;
    dct:description "Garment construction, pattern-making, materials, and the creative development process from concept to finished collection."@en ;
    dct:isPartOf fashion:Field .

fashion:sourcing a skos:Concept ;
    skos:prefLabel "Sourcing"@en ;
    skos:definition "The process of identifying, vetting, and contracting suppliers of fabric, trims, and manufacturing capacity for production."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:billOfMaterials ;
    skos:related fashion:supplyChain ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity"@en .

fashion:supplyChain a skos:Concept ;
    skos:prefLabel "Supply Chain"@en ;
    skos:definition "The full sequence of entities and processes — raw material, manufacture, logistics, retail — through which a garment moves from fiber to consumer."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:narrower fashion:sourcing ;
    skos:narrower fashion:verticalIntegration ;
    skos:related fashion:traceability .

fashion:traceability a skos:Concept ;
    skos:prefLabel "Traceability"@en ;
    skos:altLabel "chain of custody"@en ;
    skos:definition "The ability to track a garment's materials and production steps back through the supply chain, typically for compliance, sustainability, or authenticity claims."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:supplyChain ;
    skos:related fashion:certification .

fashion:verticalIntegration a skos:Concept ;
    skos:prefLabel "Vertical Integration"@en ;
    skos:definition "A business model in which one company controls multiple stages of the supply chain — e.g. manufacturing and retail — rather than outsourcing them."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:broader fashion:supplyChain ;
    skos:related fashion:fastFashion .

fashion:privateLabel a skos:Concept ;
    skos:prefLabel "Private Label"@en ;
    skos:altLabel "own brand"@en ;
    skos:altLabel "store brand"@en ;
    skos:definition "Merchandise manufactured by a third party but sold under a retailer's own brand name rather than the manufacturer's."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:licensing .

fashion:licensing a skos:Concept ;
    skos:prefLabel "Licensing"@en ;
    skos:altLabel "brand licensing"@en ;
    skos:definition "An agreement allowing a manufacturer to produce and sell goods under a designer's or brand's name in exchange for royalties, common in fragrance, eyewear, and accessories."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:privateLabel ;
    skos:related fashion:brandExtension ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity (a legal/contractual activity)"@en .

fashion:wholesale a skos:Concept ;
    skos:prefLabel "Wholesale"@en ;
    skos:definition "Selling goods in bulk to retailers at a discounted per-unit price, for onward resale to consumers, as distinct from direct-to-consumer selling."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:directToConsumer ;
    skos:related fashion:markup .

fashion:directToConsumer a skos:Concept ;
    skos:prefLabel "Direct-to-Consumer"@en ;
    skos:altLabel "DTC"@en ;
    skos:altLabel "D2C"@en ;
    skos:definition "A distribution model in which a brand sells directly to end customers, bypassing wholesale intermediaries, typically via owned e-commerce or retail."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:wholesale ;
    skos:related fashion:ecommerce .

fashion:buying a skos:Concept ;
    skos:prefLabel "Buying"@en ;
    skos:altLabel "merchandise buying"@en ;
    skos:definition "The retail function of selecting and ordering product from suppliers for a store or platform, balancing trend, margin, and forecasted demand."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:narrower fashion:openToBuy ;
    skos:related fashion:merchandising .

fashion:openToBuy a skos:Concept ;
    skos:prefLabel "Open-to-Buy"@en ;
    skos:altLabel "OTB"@en ;
    skos:definition "A budgeting tool that sets the dollar amount a buyer has available to purchase new inventory within a given period, based on planned sales, stock, and markdowns."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:broader fashion:buying .

fashion:merchandising a skos:Concept ;
    skos:prefLabel "Merchandising"@en ;
    skos:definition "The planning and management of product assortment, pricing, and presentation to maximize sales across a retail season."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:narrower fashion:visualMerchandising ;
    skos:related fashion:buying ;
    skos:related fashion:assortmentPlanning .

fashion:assortmentPlanning a skos:Concept ;
    skos:prefLabel "Assortment Planning"@en ;
    skos:definition "Determining the mix, depth, and breadth of styles, sizes, and colors a retailer will carry for a given season or store."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:broader fashion:merchandising ;
    skos:related fashion:buying .

fashion:markup a skos:Concept ;
    skos:prefLabel "Markup"@en ;
    skos:definition "The amount added to a garment's cost price to set its retail price, usually expressed as a percentage or multiplier (e.g. \"2.5x cost\")."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:margin ;
    skos:related fashion:markdown .

fashion:margin a skos:Concept ;
    skos:prefLabel "Margin"@en ;
    skos:altLabel "gross margin"@en ;
    skos:definition "The difference between selling price and cost, expressed as a percentage of the selling price; the core profitability metric in fashion retail."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:markup ;
    skos:related fashion:markdown .

fashion:markdown a skos:Concept ;
    skos:prefLabel "Markdown"@en ;
    skos:definition "A reduction in a product's retail price, applied to move slow-selling stock and recover cash flow before a season closes."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:sellThrough ;
    skos:related fashion:margin .

fashion:sellThrough a skos:Concept ;
    skos:prefLabel "Sell-Through"@en ;
    skos:altLabel "sell-through rate"@en ;
    skos:definition "The percentage of received inventory sold within a given period, a key indicator of how well a style or collection is performing."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:markdown ;
    skos:related fashion:openToBuy .

fashion:minimumOrderQuantity a skos:Concept ;
    skos:prefLabel "Minimum Order Quantity"@en ;
    skos:altLabel "MOQ"@en ;
    skos:definition "The smallest quantity of a style a manufacturer will agree to produce in a single order, a key constraint for small and emerging brands."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:sourcing .

fashion:leadTime a skos:Concept ;
    skos:prefLabel "Lead Time"@en ;
    skos:definition "The elapsed time between placing a production order and receiving finished goods, a critical planning variable across sourcing and buying."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:sourcing ;
    skos:related fashion:fastFashion .

fashion:fastFashion a skos:Concept ;
    skos:prefLabel "Fast Fashion"@en ;
    skos:definition "A business model built on rapid design-to-shelf turnaround and frequent new-product drops, prioritizing speed and trend responsiveness over durability."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:leadTime ;
    skos:related fashion:slowFashion .

fashion:slowFashion a skos:Concept ;
    skos:prefLabel "Slow Fashion"@en ;
    skos:definition "A production and consumption philosophy emphasizing durability, ethical labor, and reduced volume, positioned as a counter-model to fast fashion."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:fastFashion ;
    skos:related fashion:sustainability .

fashion:circularFashion a skos:Concept ;
    skos:prefLabel "Circular Fashion"@en ;
    skos:altLabel "circularity"@en ;
    skos:definition "A model designed to keep garments and materials in use through resale, rental, repair, and recycling, minimizing the flow of virgin material in and waste out."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:narrower fashion:resale ;
    skos:narrower fashion:rental ;
    skos:related fashion:sustainability .

fashion:resale a skos:Concept ;
    skos:prefLabel "Resale"@en ;
    skos:altLabel "secondhand"@en ;
    skos:altLabel "recommerce"@en ;
    skos:definition "The sale of previously owned garments through dedicated platforms or brand-run take-back programs."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:broader fashion:circularFashion ;
    skos:related fashion:rental .

fashion:rental a skos:Concept ;
    skos:prefLabel "Rental"@en ;
    skos:altLabel "fashion rental"@en ;
    skos:altLabel "subscription rental"@en ;
    skos:definition "A model in which consumers pay to borrow garments for a limited period rather than purchase them outright."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:broader fashion:circularFashion ;
    skos:related fashion:resale .

fashion:sustainability a skos:Concept ;
    skos:prefLabel "Sustainability"@en ;
    skos:definition "Practices intended to reduce the environmental and social impact of fashion production and consumption across the product lifecycle."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:slowFashion ;
    skos:related fashion:circularFashion ;
    skos:related fashion:certification .

fashion:certification a skos:Concept ;
    skos:prefLabel "Certification"@en ;
    skos:definition "Third-party verification that a product, material, or facility meets defined environmental or labor standards (e.g. GOTS, Fair Trade, Bluesign)."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:traceability ;
    skos:related fashion:sustainability ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document (the certificate) issued via crm:E7_Activity"@en .

fashion:franchise a skos:Concept ;
    skos:prefLabel "Franchise"@en ;
    skos:definition "A contractual arrangement letting an independent operator run a store under a brand's name and system in exchange for fees, common for market entry in new territories."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:licensing .

fashion:showroom a skos:Concept ;
    skos:prefLabel "Showroom"@en ;
    skos:definition "A space, physical or digital, where a brand presents its collection to wholesale buyers and press for ordering and coverage decisions."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:wholesale ;
    skos:related fashion:tradeShow ;
    skos:note "CIDOC-CRM mapping: crm:E53_Place (the space itself)"@en .

fashion:tradeShow a skos:Concept ;
    skos:prefLabel "Trade Show"@en ;
    skos:altLabel "trade fair"@en ;
    skos:definition "A scheduled industry event where multiple brands present collections to buyers, press, and other trade professionals under one roof."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:showroom ;
    skos:note "CIDOC-CRM mapping: crm:E5_Event"@en .

fashion:brandExtension a skos:Concept ;
    skos:prefLabel "Brand Extension"@en ;
    skos:definition "Launching a new product category (e.g. fragrance, homeware) under an existing brand name to leverage its recognition into adjacent markets."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:licensing .

fashion:ecommerce a skos:Concept ;
    skos:prefLabel "E-Commerce"@en ;
    skos:altLabel "online retail"@en ;
    skos:definition "The sale of fashion goods through digital storefronts, encompassing owned websites, marketplaces, and social commerce."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:directToConsumer .

fashion:massMarket a skos:Concept ;
    skos:prefLabel "Mass Market"@en ;
    skos:definition "The segment of the fashion industry producing high-volume, lower-priced goods for the broadest possible consumer base."@en ;
    skos:inScheme fashion:fashion_business ;
    skos:related fashion:pretAPorter ;
    skos:related fashion:fastFashion .

fashion:brandIdentity a skos:Concept ;
    skos:prefLabel "Brand Identity"@en ;
    skos:definition "The consistent set of visual, verbal, and experiential signals — logo, typography, color, tone — through which a fashion brand is recognized."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:narrower fashion:brandVoice ;
    skos:narrower fashion:visualIdentity ;
    skos:related fashion:brandNarrative .

fashion:brandVoice a skos:Concept ;
    skos:prefLabel "Brand Voice"@en ;
    skos:altLabel "tone of voice"@en ;
    skos:definition "The characteristic style, vocabulary, and attitude a brand uses in written and spoken communication across all channels."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:broader fashion:brandIdentity ;
    skos:related fashion:brandNarrative .

fashion:visualIdentity a skos:Concept ;
    skos:prefLabel "Visual Identity"@en ;
    skos:definition "The codified visual system — logo, color palette, typography, photography style — applied consistently across a brand's touchpoints."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:broader fashion:brandIdentity ;
    skos:related fashion:artDirection .

fashion:brandNarrative a skos:Concept ;
    skos:prefLabel "Brand Narrative"@en ;
    skos:altLabel "brand story"@en ;
    skos:definition "The overarching story a brand tells about its origin, values, and purpose, used to give coherence to campaigns and product launches."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:brandIdentity ;
    skos:related fashion:brandVoice .

fashion:artDirection a skos:Concept ;
    skos:prefLabel "Art Direction"@en ;
    skos:definition "The creative oversight of a campaign, shoot, or show's visual execution — casting, set, lighting, composition — to realize a defined concept."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:campaign ;
    skos:related fashion:visualIdentity .

fashion:campaign a skos:Concept ;
    skos:prefLabel "Campaign"@en ;
    skos:altLabel "ad campaign"@en ;
    skos:definition "A coordinated set of images, film, and messaging produced to promote a collection or brand moment across paid and owned media."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:artDirection ;
    skos:related fashion:lookbook ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity (the production process); outputs are crm:E31_Document / crm:E38_Image"@en .

fashion:lookbook a skos:Concept ;
    skos:prefLabel "Lookbook"@en ;
    skos:definition "A curated set of photographs presenting a collection's key looks, used by press, buyers, and consumers to preview a season."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:campaign ;
    skos:related fashion:collection ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:editorial a skos:Concept ;
    skos:prefLabel "Editorial"@en ;
    skos:altLabel "fashion editorial"@en ;
    skos:altLabel "fashion story"@en ;
    skos:definition "A styled photographic feature published in a magazine or online platform, built around a concept rather than direct product promotion."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:styling ;
    skos:related fashion:artDirection ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:styling a skos:Concept ;
    skos:prefLabel "Styling"@en ;
    skos:definition "Selecting and combining garments, accessories, and props to create a specific look for a shoot, show, or personal client."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:narrower fashion:personalStyling ;
    skos:related fashion:editorial .

fashion:personalStyling a skos:Concept ;
    skos:prefLabel "Personal Styling"@en ;
    skos:definition "One-to-one styling services provided to an individual client for their wardrobe or a specific occasion, as distinct from editorial or show styling."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:broader fashion:styling .

fashion:runwayShow a skos:Concept ;
    skos:prefLabel "Runway Show"@en ;
    skos:altLabel "fashion show"@en ;
    skos:altLabel "catwalk show"@en ;
    skos:definition "A live presentation in which models walk a defined path wearing a collection's looks in sequence, for press, buyers, and increasingly livestream audiences."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:presentation ;
    skos:related fashion:fashionWeek ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity"@en .

fashion:presentation a skos:Concept ;
    skos:prefLabel "Presentation"@en ;
    skos:altLabel "static presentation"@en ;
    skos:definition "A collection preview format in which looks are shown on stationary models or mannequins for guests to view at their own pace, as an alternative to a runway show."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:runwayShow ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity"@en .

fashion:fashionWeek a skos:Concept ;
    skos:prefLabel "Fashion Week"@en ;
    skos:definition "A scheduled series of runway shows and presentations held in a given city, at which brands unveil upcoming seasonal collections to press and buyers."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:narrower fashion:runwayShow ;
    skos:note "CIDOC-CRM mapping: crm:E5_Event"@en .

fashion:pressKit a skos:Concept ;
    skos:prefLabel "Press Kit"@en ;
    skos:altLabel "media kit"@en ;
    skos:definition "A packaged set of materials — images, product details, brand background — distributed to journalists to support coverage of a launch or collection."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:pressRelease ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:pressRelease a skos:Concept ;
    skos:prefLabel "Press Release"@en ;
    skos:definition "A formal written announcement distributed to media to communicate news — a launch, partnership, or appointment — in a brand's official framing."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:pressKit ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:seeding a skos:Concept ;
    skos:prefLabel "Seeding"@en ;
    skos:altLabel "gifting"@en ;
    skos:altLabel "PR seeding"@en ;
    skos:definition "Sending product to press, stylists, or influencers without charge in the hope of earning organic coverage or wear."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:influencerMarketing .

fashion:influencerMarketing a skos:Concept ;
    skos:prefLabel "Influencer Marketing"@en ;
    skos:definition "Paid or gifted partnerships with individuals who have an established audience, used to promote product or brand messaging through their own channels."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:seeding ;
    skos:related fashion:brandAmbassador .

fashion:brandAmbassador a skos:Concept ;
    skos:prefLabel "Brand Ambassador"@en ;
    skos:definition "An individual, often a public figure, contracted to represent a brand publicly and consistently over an extended period, beyond a single campaign."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:influencerMarketing ;
    skos:related fashion:campaign .

fashion:frontRow a skos:Concept ;
    skos:prefLabel "Front Row"@en ;
    skos:definition "The seating position closest to the runway at a fashion show, reserved for top editors, buyers, celebrities, and VIP guests as a visible signal of status and access."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:runwayShow .

fashion:visualMerchandising a skos:Concept ;
    skos:prefLabel "Visual Merchandising"@en ;
    skos:altLabel "VM"@en ;
    skos:definition "The design of in-store and window displays to present product attractively and guide customer movement and purchase decisions."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:merchandising ;
    skos:related fashion:windowDisplay .

fashion:windowDisplay a skos:Concept ;
    skos:prefLabel "Window Display"@en ;
    skos:definition "A curated arrangement of product and props in a store's street-facing window, used as a brand's most public communication surface."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:visualMerchandising .

fashion:fashionFilm a skos:Concept ;
    skos:prefLabel "Fashion Film"@en ;
    skos:definition "A short film produced to communicate a brand's aesthetic and narrative, distinct from a straightforward product advertisement."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:campaign ;
    skos:related fashion:artDirection ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:socialCommerce a skos:Concept ;
    skos:prefLabel "Social Commerce"@en ;
    skos:definition "The integration of purchasing directly into social media platforms, collapsing discovery and checkout into a single interaction."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:influencerMarketing ;
    skos:related fashion:ecommerce .

fashion:userGeneratedContent a skos:Concept ;
    skos:prefLabel "User-Generated Content"@en ;
    skos:altLabel "UGC"@en ;
    skos:definition "Photos, videos, or reviews created by consumers rather than the brand, often reshared as a lower-cost, higher-trust form of social proof."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:socialCommerce .

fashion:brandCollaboration a skos:Concept ;
    skos:prefLabel "Brand Collaboration"@en ;
    skos:altLabel "collab"@en ;
    skos:definition "A limited joint project between two brands, or a brand and an individual creative, that combines both names' identities into a distinct co-branded release."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:capsuleCollection ;
    skos:related fashion:campaign .

fashion:sizeInclusivity a skos:Concept ;
    skos:prefLabel "Size Inclusivity"@en ;
    skos:definition "A brand communication and design commitment to offering and representing an extended range of body sizes across product and campaign imagery."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:brandNarrative .

fashion:heritage a skos:Concept ;
    skos:prefLabel "Heritage"@en ;
    skos:altLabel "brand heritage"@en ;
    skos:definition "A brand's use of its own history, archive, and founding narrative as a communication asset to establish authenticity and longevity."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:brandNarrative ;
    skos:related fashion:archive .

fashion:archive a skos:Concept ;
    skos:prefLabel "Archive"@en ;
    skos:altLabel "fashion archive"@en ;
    skos:definition "A brand's or institution's preserved collection of historical garments, sketches, and documents, maintained for reference, exhibition, and heritage communication."@en ;
    skos:inScheme fashion:fashion_communication ;
    skos:related fashion:heritage ;
    skos:note "CIDOC-CRM mapping: crm:E78_Curated_Holding (a collection curated and maintained as a unit)"@en .

fashion:silhouette a skos:Concept ;
    skos:prefLabel "Silhouette"@en ;
    skos:altLabel "shape"@en ;
    skos:altLabel "line"@en ;
    skos:definition "The overall outer contour of a garment or outfit, independent of surface detail, fabric, or color."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:narrower fashion:aLine ;
    skos:narrower fashion:sheath ;
    skos:narrower fashion:empireLine ;
    skos:related fashion:draping ;
    skos:related fashion:fit ;
    skos:scopeNote "A vocabulary term used across design and buying to communicate shape quickly (\"boxy silhouette,\" \"hourglass silhouette\") without reference to fabrication."@en .

fashion:aLine a skos:Concept ;
    skos:prefLabel "A-Line"@en ;
    skos:definition "A silhouette that narrows at the shoulders and flares gradually toward the hem, tracing the shape of the letter A."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:silhouette .

fashion:sheath a skos:Concept ;
    skos:prefLabel "Sheath"@en ;
    skos:altLabel "column dress"@en ;
    skos:definition "A close-fitting silhouette that follows the body's natural line from shoulder to hem with minimal flare."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:silhouette .

fashion:empireLine a skos:Concept ;
    skos:prefLabel "Empire Line"@en ;
    skos:altLabel "empire waist"@en ;
    skos:definition "A silhouette with the waistline raised to sit just below the bust, with fabric falling loosely from that seam to the hem."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:silhouette .

fashion:patternMaking a skos:Concept ;
    skos:prefLabel "Pattern Making"@en ;
    skos:altLabel "patternmaking"@en ;
    skos:altLabel "flat pattern cutting"@en ;
    skos:definition "The technical process of translating a design sketch or draped form into flat templates (\"pattern pieces\") used to cut fabric."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:narrower fashion:draping ;
    skos:narrower fashion:grading ;
    skos:related fashion:toile ;
    skos:related fashion:sloper ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity (a type of crm:E65_Creation)"@en .

fashion:draping a skos:Concept ;
    skos:prefLabel "Draping"@en ;
    skos:altLabel "moulage"@en ;
    skos:definition "Shaping fabric directly on a dress form or body to develop a pattern or silhouette by eye, rather than drafting flat."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:patternMaking ;
    skos:related fashion:toile ;
    skos:related fashion:silhouette ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity"@en .

fashion:toile a skos:Concept ;
    skos:prefLabel "Toile"@en ;
    skos:altLabel "muslin"@en ;
    skos:altLabel "fitting sample"@en ;
    skos:definition "A trial garment made in inexpensive fabric to test and refine a pattern before cutting the final material."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:patternMaking ;
    skos:related fashion:fitting ;
    skos:note "CIDOC-CRM mapping: crm:E22_Human-Made_Object"@en .

fashion:sloper a skos:Concept ;
    skos:prefLabel "Sloper"@en ;
    skos:altLabel "block"@en ;
    skos:altLabel "basic block"@en ;
    skos:definition "A basic, fitted pattern template without seam allowances or style lines, used as the foundation for developing new patterns."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:patternMaking ;
    skos:related fashion:grading ;
    skos:note "CIDOC-CRM mapping: crm:E22_Human-Made_Object"@en .

fashion:grading a skos:Concept ;
    skos:prefLabel "Grading"@en ;
    skos:altLabel "size grading"@en ;
    skos:definition "Proportionally scaling a finished pattern up or down to produce the full range of garment sizes."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:patternMaking ;
    skos:related fashion:sizeChart ;
    skos:related fashion:fit ;
    skos:scopeNote "Distinct from \"fitting\" — grading is mathematical scaling, not on-body adjustment."@en .

fashion:fitting a skos:Concept ;
    skos:prefLabel "Fitting"@en ;
    skos:altLabel "fit session"@en ;
    skos:definition "A session in which a garment sample is tried on a model or form to assess and correct fit, proportion, and ease."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:toile ;
    skos:related fashion:fit ;
    skos:note "CIDOC-CRM mapping: crm:E7_Activity"@en .

fashion:fit a skos:Concept ;
    skos:prefLabel "Fit"@en ;
    skos:definition "How closely and comfortably a garment conforms to the body at key measurement points; a core quality attribute in both design and merchandising."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:grading ;
    skos:related fashion:ease ;
    skos:scopeNote "In business use, \"fit issues\" are a leading cause of returns — see fashion_business.sellThrough."@en .

fashion:ease a skos:Concept ;
    skos:prefLabel "Ease"@en ;
    skos:altLabel "wearing ease"@en ;
    skos:altLabel "design ease"@en ;
    skos:definition "The difference between body measurements and garment measurements, added for comfort (wearing ease) or stylistic volume (design ease)."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:fit ;
    skos:related fashion:silhouette .

fashion:croquis a skos:Concept ;
    skos:prefLabel "Croquis"@en ;
    skos:altLabel "fashion figure"@en ;
    skos:altLabel "fashion template"@en ;
    skos:definition "A stylized, elongated figure template used as the base for sketching fashion designs quickly."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:flatSketch ;
    skos:note "CIDOC-CRM mapping: crm:E22_Human-Made_Object (as a drawing artifact)"@en .

fashion:flatSketch a skos:Concept ;
    skos:prefLabel "Flat Sketch"@en ;
    skos:altLabel "technical flat"@en ;
    skos:altLabel "CAD flat"@en ;
    skos:altLabel "spec drawing"@en ;
    skos:definition "A precise, proportionate line drawing of a garment shown without a body, used to communicate construction detail to a pattern maker or factory."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:techPack ;
    skos:related fashion:croquis ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:techPack a skos:Concept ;
    skos:prefLabel "Tech Pack"@en ;
    skos:altLabel "technical package"@en ;
    skos:altLabel "spec sheet"@en ;
    skos:definition "The complete production document set for a garment — flats, measurements, materials, trims, and construction notes — sent to a manufacturer."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:narrower fashion:flatSketch ;
    skos:narrower fashion:billOfMaterials ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:billOfMaterials a skos:Concept ;
    skos:prefLabel "Bill of Materials"@en ;
    skos:altLabel "BOM"@en ;
    skos:definition "An itemized list of every fabric, trim, and component required to construct a garment, with quantities and suppliers."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:techPack ;
    skos:related fashion:sourcing ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:fabrication a skos:Concept ;
    skos:prefLabel "Fabrication"@en ;
    skos:definition "The specific fabric or material selected to execute a design, and the design decisions that follow from that choice (drape, hand, weight)."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:narrower fashion:textile ;
    skos:related fashion:hand ;
    skos:related fashion:drape .

fashion:textile a skos:Concept ;
    skos:prefLabel "Textile"@en ;
    skos:altLabel "fabric"@en ;
    skos:altLabel "cloth"@en ;
    skos:definition "Any woven, knitted, or non-woven material produced from fibers, used as the raw substrate of a garment."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:fabrication ;
    skos:related fashion:hand ;
    skos:note "CIDOC-CRM mapping: crm:E24_Physical_Human-Made_Thing"@en .

fashion:hand a skos:Concept ;
    skos:prefLabel "Hand"@en ;
    skos:altLabel "handfeel"@en ;
    skos:definition "The tactile quality of a fabric — how it feels to the touch (soft, crisp, slippery, dry) — used as a technical descriptor in fabric sourcing."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:textile ;
    skos:related fashion:drape .

fashion:drape a skos:Concept ;
    skos:prefLabel "Drape"@en ;
    skos:definition "How a fabric falls and moves under its own weight when hung or worn, a key criterion in fabric-to-silhouette matching."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:hand ;
    skos:related fashion:silhouette .

fashion:collection a skos:Concept ;
    skos:prefLabel "Collection"@en ;
    skos:altLabel "line"@en ;
    skos:definition "A cohesive group of garments and accessories designed and produced together around a shared concept, palette, and season."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:narrower fashion:capsuleCollection ;
    skos:related fashion:trendForecast ;
    skos:related fashion:lookbook ;
    skos:note "CIDOC-CRM mapping: crm:E65_Creation (as the creative process) — the resulting garments are individually crm:E22_Human-Made_Object"@en .

fashion:capsuleCollection a skos:Concept ;
    skos:prefLabel "Capsule Collection"@en ;
    skos:altLabel "capsule"@en ;
    skos:definition "A small, tightly edited collection of interchangeable pieces designed to mix and match, often released outside the main seasonal calendar."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:collection .

fashion:trendForecast a skos:Concept ;
    skos:prefLabel "Trend Forecast"@en ;
    skos:altLabel "trend forecasting"@en ;
    skos:definition "A predictive report on upcoming color, fabric, silhouette, and cultural directions, produced ahead of a season to guide design and buying decisions."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:collection ;
    skos:related fashion:colorStory ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:colorStory a skos:Concept ;
    skos:prefLabel "Color Story"@en ;
    skos:altLabel "colorway"@en ;
    skos:altLabel "palette"@en ;
    skos:definition "The coordinated set of colors chosen to run across a collection or a single style, developed to reinforce a season's concept."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:trendForecast .

fashion:hauteCouture a skos:Concept ;
    skos:prefLabel "Haute Couture"@en ;
    skos:altLabel "couture"@en ;
    skos:definition "Legally protected French term for custom-fitted, hand-made garments produced by houses officially recognized by the Fédération de la Haute Couture et de la Mode, meeting strict criteria on atelier size and made-to-order production."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:pretAPorter ;
    skos:related fashion:atelier ;
    skos:note "CIDOC-CRM mapping: crm:E55_Type (a type of production, applied via crm:P2_has_type to the relevant crm:E12_Production)"@en ;
    skos:scopeNote "Frequently misused generically for \"expensive\" or \"high-end\"; the term has a defined legal meaning in France."@en .

fashion:pretAPorter a skos:Concept ;
    skos:prefLabel "Prêt-à-Porter"@en ;
    skos:altLabel "ready-to-wear"@en ;
    skos:altLabel "RTW"@en ;
    skos:definition "Garments manufactured in standard sizes and produced in quantity for direct retail sale, as opposed to made-to-measure."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:hauteCouture ;
    skos:related fashion:massMarket ;
    skos:note "CIDOC-CRM mapping: crm:E55_Type"@en .

fashion:atelier a skos:Concept ;
    skos:prefLabel "Atelier"@en ;
    skos:altLabel "workshop"@en ;
    skos:altLabel "studio"@en ;
    skos:definition "The workshop where a design house's garments are constructed, historically distinguishing \"flou\" (soft dressmaking) from \"tailleur\" (tailoring) ateliers."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:hauteCouture ;
    skos:note "CIDOC-CRM mapping: crm:E53_Place (as the workshop location) — the working group itself is crm:E74_Group"@en .

fashion:sizeChart a skos:Concept ;
    skos:prefLabel "Size Chart"@en ;
    skos:altLabel "size specification"@en ;
    skos:altLabel "grading rules"@en ;
    skos:definition "A reference table of body and garment measurements for each size in a brand's range, used to standardize fit across production."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:related fashion:grading ;
    skos:note "CIDOC-CRM mapping: crm:E31_Document"@en .

fashion:zeroWaste a skos:Concept ;
    skos:prefLabel "Zero-Waste Design"@en ;
    skos:definition "A pattern-making approach that uses the entire width of fabric with no offcuts, integrating waste elimination into the cut itself rather than treating it as a post-production concern."@en ;
    skos:inScheme fashion:fashion_design ;
    skos:broader fashion:patternMaking ;
    skos:related fashion:sustainability .

